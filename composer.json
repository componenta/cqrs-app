{
    "name": "componenta/cqrs-app",
    "description": "Componenta application integration for CQRS discovery compilation",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/app": "^2.0 || ^3.0.2",
        "componenta/class-finder": "^1.0",
        "componenta/config": "^2.0.2",
        "componenta/cqrs": "^2.0.1 || ^3.0.3",
        "componenta/di": "^3.0 || ^4.0.2",
        "componenta/tokenizer": "^1.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "componenta/cqrs-lock": "Adds lock metadata and command locking.",
        "componenta/cqrs-policy": "Adds command policy integration.",
        "componenta/cqrs-retry": "Adds retry metadata and middleware.",
        "componenta/cqrs-transport": "Adds async transport metadata and dispatch."
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\CQRS\\App\\ConfigProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max"
    },
    "prefer-stable": true
}
