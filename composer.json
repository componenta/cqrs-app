{
    "name": "componenta/cqrs-app",
    "description": "Componenta application integration for CQRS discovery and explicit map building",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/app": "^5.0.0",
        "componenta/class-finder": "^2.1.0",
        "componenta/config": "^3.0.0",
        "componenta/cqrs": "^4.0.0",
        "componenta/di": "^5.0.3",
        "componenta/path-resolver": "^1.0",
        "componenta/tokenizer": "^1.0",
        "componenta/var-export": "^2.0.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "componenta/app-console": "^5.0.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "componenta/cqrs-lock": "Adds lock metadata and command locking.",
        "componenta/cqrs-policy": "Adds command policy integration.",
        "componenta/cqrs-retry": "Adds retry metadata and middleware.",
        "componenta/cqrs-transport": "Adds async transport metadata and dispatch."
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "5.0.x-dev"
        },
        "componenta": {
            "config-providers": [
                "Componenta\\CQRS\\App\\ConfigProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max",
        "test:integration": "@composer --working-dir=integration test"
    },
    "prefer-stable": true
}
